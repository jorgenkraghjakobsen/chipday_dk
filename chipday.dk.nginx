# /etc/nginx/sites-available/chipday.dk - static chipday.dk configuration

server {
    listen 80;
    server_name chipday.dk www.chipday.dk;

    # Let's Encrypt challenge
    location /.well-known/acme-challenge/ {
        root /var/www/chipday.dk;
    }

    # Redirect all HTTP requests to HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name chipday.dk www.chipday.dk;

    ssl_certificate     /etc/letsencrypt/live/chipday.dk/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/chipday.dk/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/chipday.dk/chain.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options SAMEORIGIN;
    add_header X-XSS-Protection "1; mode=block";
    add_header Referrer-Policy no-referrer;

    root /var/www/chipday.dk;
    index index.html;

    location /2026/upload/ {
        auth_basic "Chip Day 2026 - Speaker Area";
        auth_basic_user_file /etc/nginx/chipday.htpasswd;
        client_max_body_size 200M;
        proxy_pass http://127.0.0.1:5026;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /api/logo-status {
        proxy_pass http://127.0.0.1:5026;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /logos/upload/ {
        auth_basic "Chip Day 2026 - Logo Upload";
        auth_basic_user_file /etc/nginx/chipday.htpasswd;
        client_max_body_size 20M;
        proxy_pass http://127.0.0.1:5026;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /logos/ {
        auth_basic "Chip Day 2026 - Logo Upload";
        auth_basic_user_file /etc/nginx/chipday.htpasswd;
        try_files $uri $uri/ =404;
    }

    # Presentations — protected until released
    location /2026/presentations/ {
        auth_basic "Chip Day 2026 - Speaker Area";
        auth_basic_user_file /etc/nginx/chipday.htpasswd;
        try_files $uri $uri/ =404;
    }

    location /2026/presentations.zip {
        auth_basic "Chip Day 2026 - Speaker Area";
        auth_basic_user_file /etc/nginx/chipday.htpasswd;
        try_files $uri =404;
    }

    # Raw speaker uploads and merged session decks — stay protected.
    location /2026/uploads/ {
        auth_basic "Chip Day 2026 - Speaker Area";
        auth_basic_user_file /etc/nginx/chipday.htpasswd;
        try_files $uri $uri/ =404;
    }

    location /2026/merged/ {
        auth_basic "Chip Day 2026 - Speaker Area";
        auth_basic_user_file /etc/nginx/chipday.htpasswd;
        try_files $uri $uri/ =404;
    }

    # Legacy /2026/ page → redirect to /backstage/.
    # Exact matches only, so sub-paths like /2026/uploads/, /2026/merged/,
    # /2026/press-release.html continue to serve files from the webroot.
    location = /2026 {
        return 301 /backstage/;
    }
    location = /2026/ {
        return 301 /backstage/;
    }
    location = /2026/index.html {
        return 301 /backstage/;
    }

    location /backstage/ {
        auth_basic "Chip Day 2026 - Speaker Area";
        auth_basic_user_file /etc/nginx/chipday.htpasswd;
        try_files $uri $uri/ =404;
    }

    # Planning / intermediate files for 2026 — organizers only.
    location /archive/2026_dtu/backstage/ {
        auth_basic "Chip Day 2026 - Organizers";
        auth_basic_user_file /etc/nginx/chipday.htpasswd;
        autoindex on;
        try_files $uri $uri/ =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    # Cache static assets
    location ~* \.(css|js|jpg|jpeg|png|webp|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
