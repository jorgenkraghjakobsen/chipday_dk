{# Hero: next event (SDU Chips & Dip) #}
<div class="hero">
    <img src="/assets/hero-wafer.jpg" alt="Chip dies on a wafer" class="hero-wafer">
    <div class="date-badge">NEXT EVENT &middot; {{ sdu.event_date_display | upper }} &middot; <span style="white-space:nowrap">{{ sdu.time_display }}</span> &middot; SDU ODENSE</div>
    <h1>SDU <span>Chips</span> &amp; Dip</h1>
    <p>An afternoon bringing students, researchers and industry together around microelectronics and chip design in Denmark. Talks, short research pitches, posters, demos and networking at {{ sdu.venue }}.</p>
    <div class="cta-group">
        <a href="{{ sdu.registration_url }}" class="cta" target="_blank" rel="noopener">Register</a>
        <a href="/sdu/" class="cta cta-secondary">Program &amp; details</a>
    </div>
    <div class="countdown" id="countdown" data-target="{{ sdu.event_date }}">
        <div class="unit"><span class="num" data-u="d">--</span><span class="label">Days</span></div>
        <div class="unit"><span class="num" data-u="h">--</span><span class="label">Hours</span></div>
        <div class="unit"><span class="num" data-u="m">--</span><span class="label">Minutes</span></div>
    </div>
</div>

{# Past events #}
<section id="past">
    <h2>Past Events</h2>
    <p class="subtitle">Programs, photos and slides from earlier editions</p>
    <div class="upcoming-grid">
        {% for ev in events | pastEvents %}
        <a href="{{ ev.url }}" class="upcoming-card">
            <span class="upcoming-date">{{ ev.date_display }}</span>
            <strong>{{ ev.title }} {{ ev.date | truncate(4, true, "") }}</strong>
            <span class="upcoming-venue">{{ ev.venue }}</span>
            <span class="upcoming-more">Program, photos &amp; slides &rarr;</span>
        </a>
        {% endfor %}
        <a href="/archive/" class="upcoming-card">
            <span class="upcoming-date">2022&ndash;2025</span>
            <strong>Earlier DTU Chipdays</strong>
            <span class="upcoming-venue">Glassalen, DTU Lyngby</span>
            <span class="upcoming-more">Full archive &rarr;</span>
        </a>
    </div>
</section>

<hr class="divider">

{# About #}
<section id="about">
    <h2>About</h2>
    <p class="subtitle">What is DTU Chip Day?</p>
    <div class="about-grid">
        <div class="about-card">
            <h3>The Event</h3>
            <p>DTU Chip Day is a yearly half-day conference and exhibition initiated in 2022 as a post-corona initiative by DTU Compute and a group of industry players who wanted to highlight the important but often overlooked Danish semiconductor industry. Each year in early January, a small organizing team from academia and industry come together to plan the event, held every spring at DTU.</p>
        </div>
        <div class="about-card">
            <h3>Danish Chip Design</h3>
            <p>Denmark has a world-class chip design ecosystem spanning global companies with large design teams, specialized SMEs, and cutting-edge university research. From hearing aids to quantum cryptography, Danish engineers deliver silicon expertise across a wide range of domains. Chip Day brings this community together &mdash; big and small &mdash; to connect, share knowledge, and inspire the next generation.</p>
        </div>
        <div class="about-card">
            <h3>Who Should Attend</h3>
            <p>Students, faculty, and industry professionals interested in the Danish chip design ecosystem. Expect exciting talks, company exhibitions, networking, and opportunities for thesis projects and positions.</p>
        </div>
    </div>

    <h3 style="margin-top: 1.5rem; margin-bottom: 1rem;">Contact Organizing Team</h3>
    <div class="companies-grid" style="max-width: 700px;">
        {% for org in organizers %}
        <div class="about-card">
            <h3>{{ org.name }}</h3>
            <p>{{ org.role }}<br>
            <a href="mailto:{{ org.email }}">{{ org.email }}</a>
            {% if org.phone %}<br><a href="tel:{{ org.phone }}">{{ org.phone }}</a>{% endif %}
            </p>
        </div>
        {% endfor %}
    </div>
</section>
